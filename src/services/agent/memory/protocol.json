{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desk-Pet memory IPC protocol",
  "version": 2,
  "definitions": {
    "MemoryScope": { "type": "string", "enum": ["user", "card", "session"] },
    "MemoryKind": { "type": "string", "enum": ["fact", "preference", "episode", "working"] },
    "MemoryStatus": { "type": "string", "enum": ["active", "superseded", "expired", "forgotten"] },
    "WorkingState": { "type": "string", "enum": ["open", "completed", "cancelled"] },
    "MemoryChangeActor": { "type": "string", "enum": ["current_input", "user_ui", "internal"] },
    "ProactiveAttemptKind": { "type": "string", "enum": ["planning", "expression"] },
    "ProactiveAttemptStatus": { "type": "string", "enum": ["reserved", "generating", "committed", "failed", "unresolved", "skipped"] },
    "ProactiveDecisionKind": { "type": "string", "enum": ["decline", "speak_now", "schedule", "set_presence"] },
    "TemporalAnchor": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["precision", "localDate", "timezone"], "properties": { "precision": { "const": "day" }, "localDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "timezone": { "type": "string" } } }, { "type": "object", "additionalProperties": false, "required": ["precision", "instant", "timezone"], "properties": { "precision": { "const": "minute" }, "instant": { "type": "integer" }, "timezone": { "type": "string" } } }] },
    "ProactiveRecurrence": { "type": "object", "additionalProperties": false, "required": ["frequency", "localTime", "timezone"], "properties": { "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly"] }, "localTime": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" }, "timezone": { "type": "string" }, "weekdays": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 7 } }, "dayOfMonth": { "type": "integer", "minimum": 1, "maximum": 31 }, "month": { "type": "integer", "minimum": 1, "maximum": 12 } } },
    "ProactiveSourceRef": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "version", "revision", "scope", "scopeId", "fingerprint", "validUntil"], "properties": { "kind": { "type": "string", "enum": ["memory", "user_entry", "behavior", "variable", "calendar", "task", "card"] }, "id": { "type": "string" }, "version": { "type": "integer" }, "revision": { "type": "integer" }, "scope": { "$ref": "#/definitions/MemoryScope" }, "scopeId": { "type": ["string", "null"] }, "fingerprint": { "type": "string" }, "validUntil": { "type": ["integer", "null"] } } },
    "ProactiveOwner": { "type": "object", "additionalProperties": false, "required": ["sessionId", "cardId", "cardHash", "runGeneration"], "properties": { "sessionId": { "type": "string" }, "cardId": { "type": "string" }, "cardHash": { "type": "string" }, "runGeneration": { "type": "integer" } } },
    "ProactiveTask": { "type": "object", "additionalProperties": false, "required": ["id", "version", "scope", "scopeId", "sourceRefs", "intent", "eventAt", "dueAt", "nextCheckinAt", "validUntil", "timezone", "recurrence", "state", "createdAt", "updatedAt"], "properties": { "id": { "type": "string" }, "version": { "type": "integer" }, "scope": { "$ref": "#/definitions/MemoryScope" }, "scopeId": { "type": ["string", "null"] }, "sourceRefs": { "type": "array", "items": { "$ref": "#/definitions/ProactiveSourceRef" } }, "intent": { "type": "object" }, "eventAt": { "anyOf": [{ "$ref": "#/definitions/TemporalAnchor" }, { "type": "null" }] }, "dueAt": { "anyOf": [{ "$ref": "#/definitions/TemporalAnchor" }, { "type": "null" }] }, "nextCheckinAt": { "type": ["integer", "null"] }, "validUntil": { "type": ["integer", "null"] }, "timezone": { "type": "string" }, "recurrence": { "anyOf": [{ "$ref": "#/definitions/ProactiveRecurrence" }, { "type": "null" }] }, "state": { "type": "string", "enum": ["active", "completed", "cancelled", "invalidated"] }, "createdAt": { "type": "integer" }, "updatedAt": { "type": "integer" } } },
    "ProactiveTaskDraft": { "type": "object", "additionalProperties": false, "required": ["id", "scope", "scopeId", "sourceRefs", "intent", "eventAt", "dueAt", "nextCheckinAt", "validUntil", "timezone", "recurrence"], "properties": { "id": { "type": "string" }, "scope": { "$ref": "#/definitions/MemoryScope" }, "scopeId": { "type": ["string", "null"] }, "sourceRefs": { "type": "array", "items": { "$ref": "#/definitions/ProactiveSourceRef" } }, "intent": { "type": "object" }, "eventAt": { "anyOf": [{ "$ref": "#/definitions/TemporalAnchor" }, { "type": "null" }] }, "dueAt": { "anyOf": [{ "$ref": "#/definitions/TemporalAnchor" }, { "type": "null" }] }, "nextCheckinAt": { "type": ["integer", "null"] }, "validUntil": { "type": ["integer", "null"] }, "timezone": { "type": "string" }, "recurrence": { "anyOf": [{ "$ref": "#/definitions/ProactiveRecurrence" }, { "type": "null" }] } } },
    "ProactiveOpportunity": { "type": "object", "additionalProperties": false, "required": ["id", "ruleId", "sourceRefs", "owner", "intentKey", "validFrom", "validUntil", "priority", "fingerprint"], "properties": { "id": { "type": "string" }, "ruleId": { "type": "string" }, "sourceRefs": { "type": "array", "items": { "$ref": "#/definitions/ProactiveSourceRef" } }, "owner": { "$ref": "#/definitions/ProactiveOwner" }, "intentKey": { "type": "string" }, "validFrom": { "type": "integer" }, "validUntil": { "type": "integer" }, "priority": { "type": "integer" }, "fingerprint": { "type": "string" } } },
    "ProactiveBudget": { "type": "object", "additionalProperties": false, "required": ["localDate", "planningAttempts", "expressionAttempts", "successfulMessages", "reservedTokens", "usedTokens", "unknownTokens"], "properties": { "localDate": { "type": "string" }, "planningAttempts": { "type": "integer" }, "expressionAttempts": { "type": "integer" }, "successfulMessages": { "type": "integer" }, "reservedTokens": { "type": "integer" }, "usedTokens": { "type": "integer" }, "unknownTokens": { "type": "integer" } } },
    "ProactiveControl": { "type": "object", "additionalProperties": false, "required": ["enabled", "muteUntil", "revision"], "properties": { "enabled": { "type": "boolean" }, "muteUntil": { "type": ["integer", "null"] }, "revision": { "type": "integer" } } },
    "ProactiveScanRequest": { "type": "object", "additionalProperties": false, "required": ["owner", "now", "localDate"], "properties": { "owner": { "$ref": "#/definitions/ProactiveOwner" }, "now": { "type": "integer" }, "localDate": { "type": "string" }, "cursor": { "type": "string" }, "targetCursor": { "type": "string" }, "limit": { "type": "integer" }, "sourceRefs": { "type": "array", "items": { "$ref": "#/definitions/ProactiveSourceRef" } } } },
    "ProactiveMemoryTarget": { "type": "object", "additionalProperties": false, "required": ["id", "version", "scope", "scopeId", "eventAt", "dueAt", "workingState", "kind", "aliases", "sourceIds", "updatedAt"], "properties": { "id": { "type": "string" }, "version": { "type": "integer" }, "scope": { "$ref": "#/definitions/MemoryScope" }, "scopeId": { "type": ["string", "null"] }, "eventAt": { "anyOf": [{ "$ref": "#/definitions/TemporalAnchor" }, { "type": "null" }] }, "dueAt": { "anyOf": [{ "$ref": "#/definitions/TemporalAnchor" }, { "type": "null" }] }, "workingState": { "anyOf": [{ "$ref": "#/definitions/WorkingState" }, { "type": "null" }] }, "kind": { "$ref": "#/definitions/MemoryKind" }, "aliases": { "type": "array", "items": { "type": "string" } }, "sourceIds": { "type": "array", "items": { "type": "string" } }, "updatedAt": { "type": "integer" } } },
    "ProactiveScanResponse": { "type": "object", "additionalProperties": false, "required": ["tasks", "memoryTargets", "evaluatedFingerprints", "unresolvedAttempts", "usedTopicKeys", "control", "budget", "sourceRevision", "hasMore", "nextCursor", "targetHasMore", "nextTargetCursor"], "properties": { "tasks": { "type": "array", "items": { "$ref": "#/definitions/ProactiveTask" } }, "memoryTargets": { "type": "array", "items": { "$ref": "#/definitions/ProactiveMemoryTarget" } }, "evaluatedFingerprints": { "type": "array", "items": { "type": "string" } }, "unresolvedAttempts": { "type": "array", "items": { "$ref": "#/definitions/ProactiveAttempt" } }, "usedTopicKeys": { "type": "array", "items": { "type": "string" } }, "control": { "$ref": "#/definitions/ProactiveControl" }, "budget": { "$ref": "#/definitions/ProactiveBudget" }, "sourceRevision": { "type": "integer" }, "hasMore": { "type": "boolean" }, "nextCursor": { "type": ["string", "null"] }, "targetHasMore": { "type": "boolean" }, "nextTargetCursor": { "type": ["string", "null"] } } },
    "ProactiveQueryRequest": { "type": "object", "additionalProperties": false, "required": ["owner", "limit"], "properties": { "owner": { "$ref": "#/definitions/ProactiveOwner" }, "targets": { "type": "array", "items": { "type": "object" } }, "attemptIds": { "type": "array", "items": { "type": "string" } }, "sessionId": { "type": "string" }, "recentDelivered": { "type": "boolean" }, "limit": { "type": "integer" } } },
    "ProactiveAttempt": { "type": "object", "additionalProperties": false, "required": ["attemptId", "status", "sessionId", "assistantEntryId", "requestId", "owner", "sourceRefs", "usage", "sourceFingerprint", "localDate"], "properties": { "attemptId": { "type": "string" }, "status": { "$ref": "#/definitions/ProactiveAttemptStatus" }, "sessionId": { "type": "string" }, "assistantEntryId": { "type": ["string", "null"] }, "requestId": { "type": "string" }, "owner": { "$ref": "#/definitions/ProactiveOwner" }, "sourceRefs": { "type": "array", "items": { "$ref": "#/definitions/ProactiveSourceRef" } }, "usage": { "type": ["object", "null"] }, "sourceFingerprint": { "type": "string" }, "localDate": { "type": "string" } } },
    "ProactiveQueryResponse": { "type": "object", "additionalProperties": false, "required": ["tasks", "attempts", "revision"], "properties": { "tasks": { "type": "array", "items": { "$ref": "#/definitions/ProactiveTask" } }, "attempts": { "type": "array", "items": { "$ref": "#/definitions/ProactiveAttempt" } }, "revision": { "type": "integer" } } },
    "ProactiveChangeRequest": { "type": "object", "additionalProperties": false, "required": ["operationId", "baseRevision", "action", "owner"], "properties": { "operationId": { "type": "string" }, "baseRevision": { "type": "integer" }, "action": { "type": "string", "enum": ["create", "reschedule", "snooze", "complete", "cancel", "control"] }, "owner": { "$ref": "#/definitions/ProactiveOwner" }, "trustedUserEventId": { "type": "string" }, "taskId": { "type": "string" }, "expectedVersion": { "type": "integer" }, "sourceRefs": { "type": "array", "items": { "$ref": "#/definitions/ProactiveSourceRef" } }, "taskPatch": { "type": "object" }, "controlPatch": { "type": "object" } } },
    "ProactiveChangeResponse": { "type": "object", "additionalProperties": false, "required": ["revision", "task"], "properties": { "revision": { "type": "integer" }, "task": { "anyOf": [{ "$ref": "#/definitions/ProactiveTask" }, { "type": "null" }] } } },
    "ProactiveClaimRequest": { "type": "object", "additionalProperties": false, "required": ["attemptId", "requestId", "kind", "owner", "sourceRefs", "sourceFingerprint", "sourceRevision", "controlRevision", "occurrenceIds", "now", "localDate", "reservedTokens"], "properties": { "attemptId": { "type": "string" }, "requestId": { "type": "string" }, "kind": { "$ref": "#/definitions/ProactiveAttemptKind" }, "owner": { "$ref": "#/definitions/ProactiveOwner" }, "sourceRefs": { "type": "array", "items": { "$ref": "#/definitions/ProactiveSourceRef" } }, "sourceFingerprint": { "type": "string" }, "sourceRevision": { "type": "integer" }, "controlRevision": { "type": "integer" }, "occurrenceIds": { "type": "array", "items": { "type": "string" } }, "now": { "type": "integer" }, "localDate": { "type": "string" }, "reservedTokens": { "type": "integer" } } },
    "ProactiveClaimResponse": { "type": "object", "additionalProperties": false, "required": ["claimed", "reason", "leaseUntil", "revision"], "properties": { "claimed": { "type": "boolean" }, "reason": { "type": ["string", "null"] }, "leaseUntil": { "type": ["integer", "null"] }, "revision": { "type": "integer" } } },
    "ProactiveValidateRequest": { "type": "object", "additionalProperties": false, "required": ["attemptId", "owner", "now"], "properties": { "attemptId": { "type": "string" }, "owner": { "$ref": "#/definitions/ProactiveOwner" }, "now": { "type": "integer" } } },
    "ProactiveValidateResponse": { "type": "object", "additionalProperties": false, "required": ["valid", "reason", "sourceRevision", "controlRevision"], "properties": { "valid": { "type": "boolean" }, "reason": { "type": ["string", "null"] }, "sourceRevision": { "type": "integer" }, "controlRevision": { "type": "integer" } } },
    "ProactiveSettleRequest": { "type": "object", "additionalProperties": false, "required": ["attemptId", "owner", "sourceFingerprint", "localDate", "status", "decision", "usage"], "properties": { "attemptId": { "type": "string" }, "owner": { "$ref": "#/definitions/ProactiveOwner" }, "sourceFingerprint": { "type": "string" }, "localDate": { "type": "string" }, "status": { "type": "string", "enum": ["committed", "failed", "skipped", "unresolved"] }, "decision": { "anyOf": [{ "$ref": "#/definitions/ProactiveDecision" }, { "type": "null" }] }, "assistantEntryId": { "type": "string" }, "usage": { "type": ["object", "null"] }, "errorCode": { "type": "string" }, "summary": { "type": "string" } } },
    "ProactiveDecision": { "type": "object", "additionalProperties": false, "required": ["kind", "opportunityFingerprints", "topicKey", "slot", "validUntil"], "properties": { "kind": { "$ref": "#/definitions/ProactiveDecisionKind" }, "opportunityFingerprints": { "type": "array", "items": { "type": "string" } }, "topicKey": { "type": ["string", "null"] }, "slot": { "type": ["string", "null"] }, "validUntil": { "type": ["integer", "null"] }, "taskDrafts": { "type": "array", "items": { "$ref": "#/definitions/ProactiveTaskDraft" } }, "presence": { "type": ["object", "null"] } } },
    "ProactiveReconcileRequest": { "type": "object", "additionalProperties": false, "required": ["attemptId", "owner", "sourceFingerprint", "localDate", "committed", "usage"], "properties": { "attemptId": { "type": "string" }, "owner": { "$ref": "#/definitions/ProactiveOwner" }, "sourceFingerprint": { "type": "string" }, "localDate": { "type": "string" }, "assistantEntryId": { "type": "string" }, "committed": { "type": "boolean" }, "usage": { "type": ["object", "null"] } } },
    "ProactiveControlRequest": { "type": "object", "additionalProperties": false, "required": ["operationId", "baseRevision", "owner", "patch"], "properties": { "operationId": { "type": "string" }, "baseRevision": { "type": "integer" }, "owner": { "$ref": "#/definitions/ProactiveOwner" }, "patch": { "type": "object" } } },
    "MemorySource": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "sessionId", "entryId", "eventId", "seq", "contentHash", "eligibleForMemory", "taint", "origin", "observedAt"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 }, "sessionId": { "type": "string", "minLength": 1 },
        "entryId": { "type": "string", "minLength": 1 }, "eventId": { "type": "string", "minLength": 1 }, "seq": { "type": "integer", "minimum": 0 },
        "contentHash": { "type": "string", "minLength": 1 }, "evidence": { "type": "string" }, "sourceLength": { "type": "integer", "minimum": 0 },
        "cardId": { "type": "string" },
        "eligibleForMemory": { "type": "boolean" }, "taint": { "type": "string", "enum": ["trusted_user", "derived", "untrusted", "system"] },
        "origin": { "type": "string", "enum": ["user", "assistant", "tool", "system", "import"] }, "observedAt": { "type": "integer" }
      }
    },
    "MemorySourceAudit": { "type": "object", "additionalProperties": false, "required": ["sourceId", "sessionId", "entryId", "eventId", "seq", "contentHash", "origin", "taint", "observedAt"], "properties": { "sourceId": { "type": "string" }, "sessionId": { "type": "string" }, "entryId": { "type": "string" }, "eventId": { "type": "string" }, "seq": { "type": "integer" }, "contentHash": { "type": "string" }, "origin": { "type": "string" }, "taint": { "type": "string" }, "observedAt": { "type": "integer" } } },
    "MemoryHistoryEntry": { "type": "object", "additionalProperties": false, "required": ["item", "sourceAudits"], "properties": { "item": { "$ref": "#/definitions/MemoryItem" }, "sourceAudits": { "type": "array", "items": { "$ref": "#/definitions/MemorySourceAudit" } } } },
    "MemoryDraft": {
      "type": "object", "additionalProperties": false,
      "required": ["content", "summary", "kind", "scope", "aliases", "pinned", "importance", "confidence", "sourceIds"],
      "properties": {
        "content": { "type": "string", "minLength": 1 }, "summary": { "type": "string" },
        "kind": { "$ref": "#/definitions/MemoryKind" }, "scope": { "$ref": "#/definitions/MemoryScope" },
        "scopeId": { "type": "string" }, "aliases": { "type": "array", "items": { "type": "string" } },
        "pinned": { "type": "boolean" }, "importance": { "type": "number", "minimum": 0, "maximum": 10 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "observedAt": { "type": "integer" },
      "validFrom": { "type": ["integer", "null"] }, "validTo": { "type": ["integer", "null"] },
        "eventAt": { "anyOf": [{ "$ref": "#/definitions/TemporalAnchor" }, { "type": "null" }] },
        "dueAt": { "anyOf": [{ "$ref": "#/definitions/TemporalAnchor" }, { "type": "null" }] },
        "workingState": { "$ref": "#/definitions/WorkingState" },
        "expiresAt": { "type": ["integer", "null"] }, "supersedesId": { "type": ["string", "null"] },
        "sourceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "MemoryItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "status", "draft", "createdAt", "updatedAt"],
      "properties": { "id": { "type": "string" }, "version": { "type": "integer", "minimum": 1 }, "status": { "$ref": "#/definitions/MemoryStatus" }, "draft": { "$ref": "#/definitions/MemoryDraft" }, "createdAt": { "type": "integer" }, "updatedAt": { "type": "integer" } }
    },
    "MemoryJob": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "phase", "status", "revision", "forgetEpoch", "createdAt", "updatedAt"],
      "properties": { "id": { "type": "string" }, "phase": { "type": "string", "enum": ["light", "review"] }, "status": { "type": "string", "enum": ["queued", "running", "paused", "cancelled", "completed", "failed"] }, "revision": { "type": "integer" }, "forgetEpoch": { "type": "integer" }, "leaseOwner": { "type": ["string", "null"] }, "leaseUntil": { "type": ["integer", "null"] }, "cursor": { "type": "string" }, "processed": { "type": "integer" }, "createdAt": { "type": "integer" }, "updatedAt": { "type": "integer" }, "error": { "type": "string" } }
    },
    "MemoryCandidateDraft": {
      "type": "object", "additionalProperties": false,
      "required": ["draft", "payloadHash"],
      "properties": { "id": { "type": "string" }, "draft": { "$ref": "#/definitions/MemoryDraft" }, "payloadHash": { "type": "string" }, "baseRevision": { "type": "integer" }, "reason": { "type": "string" } }
    }
  },
  "commands": {
    "memory_status": { "request": {}, "response": { "type": "object", "required": ["revision", "forgetEpoch", "schemaVersion", "itemCount", "candidateCount", "jobCount"], "properties": { "revision": { "type": "integer" }, "forgetEpoch": { "type": "integer" }, "schemaVersion": { "type": "integer" }, "itemCount": { "type": "integer" }, "candidateCount": { "type": "integer" }, "jobCount": { "type": "integer" } } } },
    "memory_list": { "request": { "scope": { "$ref": "#/definitions/MemoryScope" }, "scopeId": { "type": "string" }, "limit": { "type": "integer" } }, "response": { "type": "array", "items": { "$ref": "#/definitions/MemoryItem" } } },
    "memory_detail": { "request": { "id": { "type": "string" } }, "response": { "$ref": "#/definitions/MemoryItem" } },
    "memory_history": { "request": { "id": { "type": "string" } }, "response": { "type": "array", "items": { "$ref": "#/definitions/MemoryHistoryEntry" } } },
    "memory_register_sources": { "request": { "sources": { "type": "array", "items": { "$ref": "#/definitions/MemorySource" } } }, "response": { "type": "integer" } },
    "memory_query": { "request": { "query": { "type": "string" }, "scope": { "$ref": "#/definitions/MemoryScope" }, "scopeId": { "type": "string" }, "sessionId": { "type": "string" }, "limit": { "type": "integer" }, "tokenBudget": { "type": "integer" } }, "response": { "type": "array", "items": { "$ref": "#/definitions/MemoryItem" } } },
    "memory_get_items": { "request": { "ids": { "type": "array", "items": { "type": "string" } } }, "response": { "type": "array", "items": { "$ref": "#/definitions/MemoryItem" } } },
    "memory_apply_change": { "request": { "operationId": { "type": "string" }, "baseRevision": { "type": "integer" }, "action": { "type": "string", "enum": ["add", "update", "supersede", "forget", "clear", "complete", "cancel"] }, "itemId": { "type": "string" }, "expectedVersion": { "type": "integer" }, "actor": { "$ref": "#/definitions/MemoryChangeActor" }, "trustedUserEventId": { "type": "string" }, "draft": { "$ref": "#/definitions/MemoryDraft" } }, "response": { "type": "integer" } },
    "memory_job_start": { "request": { "phase": { "type": "string", "enum": ["light", "review"] }, "leaseOwner": { "type": "string" } }, "response": { "$ref": "#/definitions/MemoryJob" } },
    "memory_job_checkpoint": { "request": { "jobId": { "type": "string" }, "cursor": { "type": "string" }, "leaseOwner": { "type": "string" }, "leaseMs": { "type": "integer" } }, "response": { "$ref": "#/definitions/MemoryJob" } },
    "memory_job_cancel": { "request": { "jobId": { "type": "string" }, "leaseOwner": { "type": "string" } }, "response": { "$ref": "#/definitions/MemoryJob" } },
    "memory_job_resume": { "request": { "jobId": { "type": "string" }, "leaseOwner": { "type": "string" } }, "response": { "$ref": "#/definitions/MemoryJob" } },
    "memory_job_sources": { "request": { "jobId": { "type": "string" } }, "response": { "type": "array", "items": { "$ref": "#/definitions/MemorySource" } } },
    "memory_candidates_add": { "request": { "jobId": { "type": "string" }, "candidates": { "type": "array", "items": { "$ref": "#/definitions/MemoryCandidateDraft" } } }, "response": { "type": "integer" } },
    "memory_dreaming_commit": { "request": { "jobId": { "type": "string" }, "baseRevision": { "type": "integer" } }, "response": { "type": "integer" } },
    "memory_dreaming_budget_reserve": { "request": { "reservationId": { "type": "string", "minLength": 1 }, "localDate": { "type": "string" }, "reservedTokens": { "type": "integer", "minimum": 0 }, "dailyLimit": { "type": "integer", "minimum": 0 } }, "response": { "type": "boolean" } },
    "memory_dreaming_budget_settle": { "request": { "reservationId": { "type": "string", "minLength": 1 }, "localDate": { "type": "string" }, "reservedTokens": { "type": "integer", "minimum": 0 }, "usedTokens": { "type": ["integer", "null"], "minimum": 0 } }, "response": { "type": "null" } },
    "memory_dreaming_budget": { "request": { "localDate": { "type": "string" } }, "response": { "type": "object", "required": ["localDate", "reservedTokens", "usedTokens"], "properties": { "localDate": { "type": "string" }, "reservedTokens": { "type": "integer" }, "usedTokens": { "type": "integer" } } } },
    "memory_export": { "request": {}, "response": { "type": "string" } },
    "memory_backup": { "request": {}, "response": { "type": "string" } },
    "memory_rebuild": { "request": {}, "response": { "type": "integer" } },
    "memory_restore": { "request": { "backupPath": { "type": "string" } }, "response": { "type": "integer" } }
  }
}
