# ==========================================
# 本地开发配置模版 — 使用时去除 .example 后缀
# ==========================================

general:
  popup: { mode: cursor, autoPopupOnMessage: false, defaultSize: { w: 448, h: 272 }, fixedPosition: null, chatWidth: 220 }
  shortcut: { key: "P", macModifiers: ["Control", "Command"], winModifiers: ["Control", "Alt"] }
  logging: { level: debug }
  # 错误覆盖层：auto(dev 弹/生产不弹) | always | never
  errors: { overlay: auto }
  desktop: { pollingIntervalMs: 3000 }

ai:
  provider: deepseek
  endpoint: ""
  apiKey: ""
  requireApiKey: true
  model: deepseek-chat
  # 辅助模型：子代理（agent_spawn 工具、计划步骤）、主动扫描规划与记忆整理（dreaming）使用；
  # 留空跟随聊天模型（同一 provider/endpoint/apiKey）
  auxModel: ""
  # 上下文窗口（tokens）：默认 128k，最低 65536（再低压缩找不到可摘要范围）
  contextMaxTokens: 131072
  thinking:
    effort: auto
  conversation:
    # 忙碌时未显式选择的默认投递方式：steer=插话 / followUp=稍后继续（空闲发送不受影响）
    defaultDelivery: steer
    # 插话批量策略：all=同一安全边界前积压的补充一起处理 | one-at-a-time=逐条
    steeringMode: all
    # 稍后继续的批量策略：one-at-a-time=逐条保留话题边界 | all=集中处理
    followUpMode: one-at-a-time
  personality:
    active: angelkawaii
  loop:
    maxRetry: 3
    maxToolCallsPerTurn: 5
    toolTimeoutMs: 30000
    turnTimeoutMs: 120000
    dedupWindowMs: 30000
    maxVisibleMessages: 200
    # 同时执行的只读（shared_read）工具数上限，范围 1–8；每个 run 开始前下发给许可所有者
    maxParallelTools: 4
  memory:
    enabled: true
    coreTokenBudget: 320
    recallTokenBudget: 1000
    rerank: off
    recallTimeoutMs: 4000
    rerankTimeoutMs: 2500
    # reviewMaxTokens：单次 Review 输出上限；reasoning 模型的 thinking 也计入，推理模型需调大
    dreaming: { mode: idle, idleSeconds: 120, minIntervalMinutes: 60, maxDailyTokens: 12000, reviewMaxTokens: 1200 }
    maxSessions: 20
  plan:
    enabled: true
    complexityThreshold: 3
    complexityEval: keyword
    maxSteps: 8
    stepTimeoutMs: 90000
    stepMaxRounds: 5
    thinkingEffort: medium
    stepThinkingEffort: low
    onStepFailure: continue
    keywords: [分析, 整理, 重构, 修复, 审查, 合并, 总结, 生成, 创建项目]
  lock: { safetyTimeoutMs: 30000 }
  windowMonitor:
    enabled: true
    staySeconds: 60
    settleMs: 2000
    # 冷却时长统一毫秒
    cooldownMs: 5000
    samePageCooldownMs: 7800
  safety: { mode: tell_me, sessionTrustEnabled: true }

tools:
  bash:
    whitelist: ["ls", "cat", "head", "tail", "grep", "find", "which", "echo", "pwd", "date", "whoami", "uname", "df", "du", "ps", "tasklist", "system_profiler", "ifconfig"]
  mcp:
    # 无总闸：按每服务器 enabled 控制，全部关闭即不使用 MCP；五个内置项默认关闭
    servers: []
    builtin:
      filesystem:  { enabled: false, command: npx, args: ["-y", "@modelcontextprotocol/server-filesystem", "/"], description: "📁 文件系统操作" }
      brave-search: { enabled: false, command: npx, args: ["-y", "@brave/brave-search-mcp-server"], env: { BRAVE_API_KEY: "" }, description: "🔍 Brave Search" }
      playwright:   { enabled: false, command: npx, args: ["-y", "@executeautomation/playwright-mcp-server"], description: "🎭 Playwright" }
      git:          { enabled: false, command: npx, args: ["-y", "@anthropic/mcp-git", "/"], description: "📝 Git" }
      github:       { enabled: false, command: npx, args: ["-y", "@anthropic/mcp-github"], env: { GITHUB_PERSONAL_ACCESS_TOKEN: "" }, description: "🐙 GitHub" }

appearance:
  activeProfile: "sugar-pink"
  effectMode: "off"               # off | parallax(灵动图层) | dof(景深)，互斥
  soundAssignments: {}            # 事件 → 音效 ID；空表示全走内置默认，设置页可改
  parallax:
    intensity: 1.0
  font:
    family: ""                    # 全局字体（用户电脑上已安装的字体名）；空 = 跟随系统默认字体栈
    size: 14                      # 全局字号 px
