# ==========================================
# 本地开发配置模版 — 使用时去除 .example 后缀
# ==========================================

general:
  popup: { mode: fixed, autoPopupOnMessage: false, defaultSize: { w: 673, h: 444 }, fixedPosition: { x: 252, y: 285 }, chatWidth: 266 }
  shortcut: { key: "P", macModifiers: ["Control", "Command"], winModifiers: ["Control", "Alt"] }
  logging: { level: debug }
  # 错误覆盖层：auto(dev 弹/生产不弹) | always | never
  errors: { overlay: auto }

ai:
  provider: deepseek
  endpoint: https://api.deepseek.com
  apiKey: ""
  requireApiKey: true
  model: deepseek-flash
  # 辅助模型：子代理（agent_spawn 工具、计划步骤）、主动扫描规划与记忆整理（dreaming）使用；
  # 留空跟随聊天模型（同一 provider/endpoint/apiKey）
  auxModel: ""
  # 上下文窗口（tokens）：默认 256k，最低 65536（再低压缩找不到可摘要范围）
  contextMaxTokens: 262144
  thinking:
    effort: auto
  conversation:
    # 忙碌时未显式选择的默认投递方式：steer=插话 / followUp=稍后继续（空闲发送不受影响）
    defaultDelivery: steer
    # 插话批量策略：all=同一安全边界前积压的补充一起处理 | one-at-a-time=逐条
    steeringMode: all
    # 稍后继续的批量策略：one-at-a-time=逐条保留话题边界 | all=集中处理
    followUpMode: one-at-a-time
  personality:
    active: default
  loop:
    maxRetry: 3
    # agent 子代理工具轮上限（无人值守子运行）；主聊天回合已无计数上限，走循环病理检测
    subAgentRounds: 5
    toolTimeoutMs: 30000
    # 主回合/恢复的墙钟；必须 ≥ bash 档位（5 分钟）+ 一次模型往返，否则长命令被回合整体 abort。
    turnTimeoutMs: 600000
    dedupWindowMs: 30000
    maxVisibleMessages: 200
    # 同时执行的只读（shared_read）工具数上限，范围 1–8；每个 run 开始前下发给许可所有者
    maxParallelTools: 4
  memory:
    enabled: true
    coreTokenBudget: 320
    recallTokenBudget: 1000
    # 统一事实/画像/原话查询改写：off | adaptive；技术参数，YAML修改后重启生效
    queryRewrite: adaptive
    rerank: off
    recallTimeoutMs: 4000
    rerankTimeoutMs: 2500
    # 整理档位：off(不自动跑，手动整理按钮保留) | low | medium | high；档位值收进协议表 tiers
    # reviewMaxTokens：单次 Review 输出上限；缺省 = 按模型输出预算自动推导（窗口×1/8，32k 封顶）
    dreaming: { tier: high }
    maxSessions: 20
  plan:
    enabled: true
    complexityThreshold: 3
    complexityEval: keyword
    maxSteps: 8
    # 单个计划步骤的墙钟；计划由用户在场批准，按 bash 档位（5 分钟）对齐，避免 90s 截断长命令。
    stepTimeoutMs: 300000
    stepMaxRounds: 5
    thinkingEffort: medium
    stepThinkingEffort: low
    onStepFailure: continue
    keywords: [分析, 整理, 重构, 修复, 审查, 合并, 总结, 生成, 创建项目]
  humanizer:
    enabled: true

  # 主动消息档位 + 静默时间段（仅约束主动消息；跨夜 start > end，start == end = 不静默）
  proactive: { frequency: high, quietStartHour: 0, quietEndHour: 0 }
  # 静默了解总闸 + 频率：off(不自动跑，读取靠手动) | low | medium | high
  # （原 enabled 与四个节奏数值字段已删，数值收进 proactive/protocol.json 的 tiers。）
  silentAccess: { frequency: high }
  safety: { mode: tell_me, sessionTrustEnabled: true }

tools:
  bash:
    whitelist: ["ls", "cat", "head", "tail", "grep", "find", "which", "echo", "pwd", "date", "whoami", "uname", "df", "du", "ps", "tasklist", "system_profiler", "ifconfig"]
  mcp:
    # 无总闸：按每服务器 enabled 控制，全部关闭即不使用 MCP
    # 服务器列表。transport: stdio 用 command/args/env（npx -y <包> 形态由宿主托管安装后直启，失败回退 npx）
    # transport: http 用 url/headers（Streamable HTTP，headers 值支持 ${ENV_VAR}：先查本条目 env，
    # 未命中再查应用自有凭据存储 —— 凭据值不写在本文件里）
    servers:
      # GitHub 官方远程 MCP：出厂自带、默认关闭（enabled: false = 开箱不连接）。
      # 端点对所有 GitHub 用户免费（无需 Copilot 席位；域名带 copilot 是历史命名）；纯在线依赖：无网络不可用。
      # X-MCP-Readonly: true = 只暴露只读工具；X-MCP-Toolsets 限定工具面（省 token）。
      # GITHUB_TOKEN 不写在文件里：在设置 → 工具 → MCP 的「GitHub 令牌」行动作填入
      # fine-grained、只读权限的 PAT；值存应用自有数据库（不回显、不进日志）。
      - name: github
        transport: http
        url: https://api.githubcopilot.com/mcp/
        headers:
          X-MCP-Readonly: "true"
          X-MCP-Toolsets: "context,repos,issues,pull_requests"
          Authorization: "Bearer ${GITHUB_TOKEN}"
        enabled: false

appearance:
  activeProfile: "profile2"
  effectMode: "parallax"          # off(静态) | parallax(灵动图层)，互斥
  theme: "chrome"                 # 界面主题（产品级预设，与 Profile 正交）: brushed(拉丝金属) | chrome(铬) | verdigris(铜绿) | nightfall(暮蓝) | azurite(青花)
  chatImagePreview: true          # 聊天图片自动预览: false(历史只显示占位，点击占位仍可打开查看器) | true(只为可见消息按需加载内联预览)
  # 事件 → 音效 ID；设置页可改
  soundAssignments:
    welcome: welcome_chord
    send: send_short
    reply: reply_ding
    popup: popup_up
    retract: retract_down
    surface: surface_light
    middle: middle_tremolo
    deep: deep_noise
  parallax:
    intensity: 1.0
  font:
    family: ""                    # 全局字体（用户电脑上已安装的字体名）；空 = 跟随系统默认字体栈
    size: 14                      # 全局字号 px
