# ==========================================
# Vite 环境变量示例
# 复制为 .env 后生效（.env 已在 .gitignore 中，不入库）
# 注意：这些值在 vite build 时会被烤进产物，只在无配置值时才作为回退
# ==========================================

# 运行期日志级别覆写：debug | info | warn | error
# dev 下默认全量 debug 且忽略配置，想验证「生产过滤行为」时用这个临时降级。
# 留空 = 走配置（dev 一律 debug，生产读 general.logging.level）
VITE_LOG_LEVEL=

# AI Provider —— 留空时回退到 CONFIG.yaml 的 ai.* 字段
VITE_API_ENDPOINT=
VITE_API_KEY=
VITE_MODEL=
